# macOS
.DS_Store

# Editor swap files
*.swp
*~

# Windows
Thumbs.db

# Logs
*.log

# Claude Code (local state ignored, but tracked .claude/commands/ must stay
# visible to git — a plain `.claude/` would swallow new files there too)
.claude/*
!.claude/commands/
!.claude/commands/**

# Python bytecode
__pycache__/
*.pyc
.tmp-skills/
hero-vyre/

# Finansielle maler — build tooling (not deploy content)
_build_*.py
_iterate_*.py
_eval_*.py
_verify_*.py
_inspect_*.py
_evaluated/

# Node (dev-only tooling: ESLint CI — not used by the static site at runtime)
node_modules/
